# Variables de entorno para PRODUCCION (Dokploy -> Environment)
# Copiar los valores reales en el panel; NO versionar secretos.

# --- Servidor ---
PORT=3000
NODE_ENV=production
JWT_SECRET=CAMBIAR_por_un_secreto_largo_y_aleatorio
# Duracion de la sesion. El panel la RENUEVA SOLA antes de que venza (renovacion
# deslizante con POST /api/auth/refresh), asi que mientras estes trabajando no se corta.
# Opcion extrema: JWT_EXPIRES_IN=never firma un token SIN vencimiento (menos seguro).
JWT_EXPIRES_IN=12h

# --- MongoDB (usar la URI INTERNA de Dokploy) ---
# El host interno es el nombre del servicio de la base (ej: rrhh-rrhh-itoigu)
MONGODB_URI=mongodb://giuli:CAMBIAR_PASSWORD@rrhh-rrhh-itoigu:27017/?authSource=admin&directConnection=true
MONGODB_DB=rrhh

# --- HTTPS / Traefik (Dokploy) ---
# Redirige http:// -> https:// (301). Desactivar solo si el dominio todavia no
# tiene certificado valido y no quieres enviar usuarios a un error de TLS.
FORCE_HTTPS=true
# HSTS: activar SOLO cuando Let's Encrypt ya emita el certificado del dominio.
# Publicado HSTS, el navegador ya no permite la excepcion de certificado.
HSTS_ENABLED=false
HSTS_MAX_AGE=15552000

# --- Railpack ---
# Fuerza el modo servidor Node (evita que se publique como sitio estatico con Caddy)
RAILPACK_START_CMD=npm run start:prod
RAILPACK_NODE_VERSION=22
