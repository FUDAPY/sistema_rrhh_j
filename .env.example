# Copiar a .env y completar los valores reales (NO versionar .env)

# ==== Server ====
PORT=3000
JWT_SECRET=definir-un-secreto-largo
JWT_EXPIRES_IN=12h

# ==== MongoDB ====
# En Dokploy usar la URI INTERNA (host rrhh-rrhh-itoigu:27017)
MONGODB_URI=mongodb://usuario:password@host:27017/?authSource=admin
MONGODB_DB=rrhh

# ==== Firebase (solo para migracion) ====
FIREBASE_SERVICE_ACCOUNT=ruta/al/service-account.json
MIGRATION_DEFAULT_PASSWORD=Cambiar1234
